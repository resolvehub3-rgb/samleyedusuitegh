# SamleyEduSuite Vercel Production Environment Variables
# Copy this file to .env.local for development
# Configure these in Vercel Dashboard > Project Settings > Environment Variables

# REQUIRED: Supabase Project URL (from Supabase Dashboard > Project Settings > API)
# Example: https://oswxgbvfgwrqlhbmntdi.supabase.co
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# REQUIRED: Supabase Anon (Public) Key (from Supabase Dashboard > Project Settings > API)
# This is safe for client-side use and works with Row Level Security (RLS)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
